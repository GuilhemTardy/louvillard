# --- Obligatoire -------------------------------------------------------------
# Mot de passe de l'espace /admin
ADMIN_PASSWORD=
# Clé de signature des cookies d'accès et des liens de commande (32+ caractères)
# Générer : openssl rand -base64 48
APP_SECRET=
# URL publique du site (liens, QR codes, sitemap)
NEXT_PUBLIC_SITE_URL=https://louvillard.vercel.app

# --- Stockage des photos (production) -----------------------------------------
# Créé automatiquement en connectant un store Vercel Blob *privé* au projet.
# Sans cette variable, les photos sont stockées dans .data/ (développement).
BLOB_READ_WRITE_TOKEN=

# --- Paiement Stripe ------------------------------------------------------------
STRIPE_SECRET_KEY=
# Webhook : https://<votre-domaine>/api/stripe/webhook
# événements : checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# --- E-mails (optionnel, via Resend) -------------------------------------------
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, ex. "Lou Villard <photos@louvillard.fr>"
MAIL_FROM=
# Adresse qui reçoit les messages de contact et les alertes de vente
NOTIFY_EMAIL=

# --- Divers ---------------------------------------------------------------------
# Masquer les 3 galeries de démonstration une fois les vraies en ligne
SHOW_DEMO_EVENTS=true
